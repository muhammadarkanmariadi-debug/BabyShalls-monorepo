{
  "name": "babyshalls",
  "version": "1.0.0",
  "private": true,
  "description": "Babyshalls - Boutique Children's Bookstore, Educational Toys, Hampers & Workshops",
  "workspaces": [
    "babyshalls-frontend",
    "babyshalls-backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --workspace=babyshalls-frontend\" \"npm run dev --workspace=babyshalls-backend\"",
    "dev:frontend": "npm run dev --workspace=babyshalls-frontend",
    "dev:backend": "npm run dev --workspace=babyshalls-backend",
    "build": "npm run build --workspace=babyshalls-frontend && npm run build --workspace=babyshalls-backend",
    "build:frontend": "npm run build --workspace=babyshalls-frontend",
    "build:backend": "npm run build --workspace=babyshalls-backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
