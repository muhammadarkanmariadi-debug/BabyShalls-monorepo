# ==============================================================
# BabyShalls Monorepo - Docker & Production Environment Template
# ==============================================================

# Database (PostgreSQL)
POSTGRES_USER=babyshalls
POSTGRES_PASSWORD=babyshalls_secret_password_2026
POSTGRES_DB=babyshalls_db
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379

# Backend API
BACKEND_PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://babyshalls:babyshalls_secret_password_2026@postgres:5432/babyshalls_db?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=babyshalls-jwt-production-secret-malang-2026
CORS_ORIGIN=http://localhost:3000

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# KiriminAja Logistics (Origin Klojen, Kota Malang)
KIRIMINAJA_API_KEY=kiriminaja-api-key-xxxx
KIRIMINAJA_BASE_URL=https://api.kiriminaja.com
ORIGIN_SUBDISTRICT_ID=1234

# Frontend Storefront
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_PORT=3000
