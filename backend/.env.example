# Database Configuration (PostgreSQL / MySQL / SQLite)
DATABASE_URL="postgresql://postgres:password@localhost:5432/babyshalls_db?schema=public"

# App & Server
PORT=5000
NODE_ENV=development
JWT_SECRET="babyshalls-secret-jwt-key-2026-malang"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION=false

# Hybrid Logistics: RajaOngkir V2 (Komerce) & BinderByte (Origin Kota Malang)
RAJAONGKIR_V2_API_KEYS="rajaongkir-v2-key1,rajaongkir-v2-key2"
RAJAONGKIR_V2_BASE_URL="https://rajaongkir.komerce.id/api/v1"
RAJAONGKIR_DAILY_LIMIT_PER_KEY=95
BINDERBYTE_API_KEY="binderbyte-api-key-xxxx"
BINDERBYTE_BASE_URL="https://api.binderbyte.com"
BINDERBYTE_QUOTA_TOTAL=3333
MALANG_ORIGIN_RAJAONGKIR_ID="46757"

# SMTP Email Configuration (Resi Otomatis, OTP Login & Broadcast)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="halo@babyshalls.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM_NAME="BabyShalls Malang"
SMTP_FROM_EMAIL="halo@babyshalls.com"

