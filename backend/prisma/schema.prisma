datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AgeGroup {
  NEWBORN_PLUS
  AGES_1_3
  AGES_3_PLUS
  AGES_6_PLUS
  ALL_AGES
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  name         String
  avatarUrl    String?
  phone        String?
  parentName   String?
  childName    String?
  childAge     String?
  emailOptIn   Boolean             @default(true)
  role         Role                @default(USER)
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  eventRegs    EventRegistration[]
  bookRequests BookRequest[]
  cartItems    CartItem[]
  wishlists    Wishlist[]
  otpCodes     OtpCode[]
  createdAt    DateTime            @default(now())
}

model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model BroadcastLog {
  id             String   @id @default(uuid())
  type           String   // PROMO, EVENT, CUSTOM
  referenceId    String?
  subject        String
  recipientCount Int      @default(0)
  sentCount      Int      @default(0)
  status         String   @default("SENT") // SENT, PARTIAL, FAILED, SKIPPED
  createdAt      DateTime @default(now())
}

model Address {
  id            String  @id @default(uuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String  @default("Rumah")
  receiverName  String
  receiverPhone String
  streetAddress String
  city          String
  subdistrict   String
  subdistrictId Int? // KiriminAja subdistrict ID
  postalCode    String
  isDefault     Boolean @default(false)
}

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  badge         String?
  sortOrder     Int           @default(0)
  subCategories SubCategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id          String    @id @default(uuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  badge       String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([categoryId, slug])
}

model Product {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String         @db.Text
  price         Decimal        @db.Decimal(12, 2)
  originalPrice Decimal?       @db.Decimal(12, 2) // Diskon / harga coret
  authorOrBrand String? // e.g. "Board Book Kurasi", "Melissa & Doug"
  stock         Int            @default(0)
  weight        Int            @default(300) // Berat gram untuk kalkulasi ongkir KiriminAja
  ageGroup      AgeGroup       @default(ALL_AGES)
  category      String // e.g. "Books", "Wooden Toys", "Gift Hampers"
  subCategory   String? // e.g. "Board Books", "Sensory Book", "Balok Kayu"
  images        Json // Fallback JSON array URL foto produk
  galleryImages ProductImage[] // Relasi galeri multi-image detail produk
  rating        Decimal        @default(5.0) @db.Decimal(3, 1)
  reviewsCount  Int            @default(0)
  isFeatured    Boolean        @default(false)
  isNewArrival  Boolean        @default(false)
  isBestSeller  Boolean        @default(false)
  features      Json? // Array keunggulan & spesifikasi produk

  // Relasi opsional ke Category & SubCategory untuk CMS dinamis
  categoryId     String?
  categoryRel    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId  String?
  subCategoryRel SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  reviews    Review[]
  cartItems  CartItem[]
  wishlists  Wishlist[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Review {
  id                 String     @id @default(uuid())
  productId          String
  product            Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId        String?    @unique
  orderItem          OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName           String
  location           String?    // e.g. "Malang, Jawa Timur"
  rating             Int        @default(5)
  comment            String     @db.Text
  variantInfo        String?    // e.g. "Variasi: Board Book (Edisi Spesial)"
  isVerifiedPurchase Boolean    @default(true) // Komentar hanya dari detail pesanan
  helpfulCount       Int        @default(0)
  createdAt          DateTime   @default(now())
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Wishlist {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  SHIPPING_SUBSIDY
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(FIXED_AMOUNT)
  discountValue Decimal      @db.Decimal(12, 2)
  maxDiscount   Decimal?     @db.Decimal(12, 2)
  minOrder      Decimal      @default(0) @db.Decimal(12, 2)
  maxUsage      Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  totalAmount    Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  couponCode     String?
  shippingCost   Decimal     @db.Decimal(12, 2)
  grandTotal     Decimal     @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING_PAYMENT)

  // Midtrans
  snapToken     String?
  paymentMethod String?
  paidAt        DateTime?

  // KiriminAja
  courierCode     String? // jne, jnt, sicepat, anteraja
  courierService  String? // REG, EZ
  waybillNumber   String? // Nomor Resi
  trackingHistory Json?   // Log pelacakan pengiriman KiriminAja
  shippingAddress Json    // Snapshot alamat pengiriman

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Decimal @db.Decimal(12, 2)
  quantity  Int     @default(1)
  review    Review?
}

model Event {
  id                String              @id @default(uuid())
  title             String
  slug              String              @unique
  shortCode         String?             @unique
  category          String              @default("Storytelling & Art")
  speaker           String?
  ageRecommendation String?
  description       String              @db.Text
  bannerImage       String
  eventDate         DateTime
  timeString        String // "10:00 - 12:00 WIB"
  location          String // "Toko BabyShalls Malang"
  price             Decimal             @default(0) @db.Decimal(12, 2)
  quota             Int                 @default(20)
  isActive          Boolean             @default(true)
  registrations     EventRegistration[]
  createdAt         DateTime            @default(now())
}

model EventRegistration {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  participantName String
  childName       String
  childAge        String
  whatsappNumber  String
  ticketQuantity  Int      @default(1)
  ticketCode      String?  @unique // e.g. BS-EVT-20261114-001 untuk QR Check-in
  paymentStatus   String   @default("FREE") // FREE, PENDING, PAID
  midtransOrderId String?
  status          String   @default("REGISTERED") // REGISTERED, CONFIRMED, CHECKED_IN
  createdAt       DateTime @default(now())
}

model BookRequest {
  id                String   @id @default(uuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  customerName      String?
  email             String?
  title             String
  authorPublisher   String?
  notes             String?  @db.Text
  referenceImageUrl String?
  whatsappNumber    String
  status            String   @default("PENDING") // PENDING, QUOTED, ORDERED, COMPLETED
  adminNotes        String?  @db.Text
  createdAt         DateTime @default(now())
}

model SiteContent {
  key       String   @id // e.g. "announcement_bar", "hero_headline"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

enum LogisticsProvider {
  RAJAONGKIR_V2
  BINDERBYTE
}

enum WaybillDeliveryStatus {
  UNKNOWN
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

model ShippingRegion {
  id             String  @id @default(uuid())
  provinceName   String
  cityName       String
  districtName   String
  postalCode     String?
  rajaongkirId   String  @unique
  binderbyteCode String?
  searchLabel    String
  isOrigin       Boolean @default(false)

  @@index([searchLabel])
  @@index([cityName, districtName])
}

model ShippingRateCache {
  id            String            @id @default(uuid())
  originId      String
  destinationId String
  weightGram    Int
  courier       String
  provider      LogisticsProvider
  ratesJson     Json
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([originId, destinationId, weightGram, courier], name: "rate_cache_key")
  @@index([expiresAt])
}

model WaybillTrackingCache {
  id             String                @id @default(uuid())
  waybillNumber  String
  courier        String
  status         WaybillDeliveryStatus @default(UNKNOWN)
  isDelivered    Boolean               @default(false)
  summaryJson    Json?
  historyJson    Json
  lastCheckedAt  DateTime              @default(now())
  nextCheckAfter DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([courier, waybillNumber], name: "waybill_courier_key")
  @@index([isDelivered, nextCheckAfter])
}

model LogisticsApiUsageLog {
  id          String            @id @default(uuid())
  dateKey     String
  provider    LogisticsProvider
  keyAlias    String            @default("DEFAULT")
  hitCount    Int               @default(0)
  isExhausted Boolean           @default(false)
  lastError   String?
  updatedAt   DateTime          @updatedAt

  @@unique([dateKey, provider, keyAlias], name: "usage_date_provider_key")
}
